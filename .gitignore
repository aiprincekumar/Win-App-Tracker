# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Local databases & WAL files (preserve directory placeholders)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
!**/.gitkeep

# Log files & diagnostics
*.log
*.tmp
hud_pythonw.log
err.log

# Reports generated during runtime (preserve .gitkeep)
reports/*.html
reports/*.csv
reports/*.json
!reports/.gitkeep

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# OS generated files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Environment and sensitive secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
